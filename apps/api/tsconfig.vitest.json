{
  "extends": "@workspace/typescript-config/tsconfig.nestjs.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./src/*"],
      "@test-fixtures/*": ["./test-fixtures/*"]
    }
  },
  "include": [
    "src/**/*",
    "__e2e__/**/*",
    "src/__tests__",
    "test-fixtures/**/*"
  ],
  "exclude": ["node_modules", "dist", "build"]
}
