# Environment Configuration
# Copy this file to .env and modify as needed

# App environment
NODE_ENV=development

# App port
PORT=3000

# Database connection string
# Port must match DATABASE_PORT in the root .env (docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nestjs

# Database connection pool config
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=10000

# Health check memory ceilings in MB (defaults 512 / 1024); size them to the
# container's memory limit
# HEALTH_MAX_HEAP_MB=512
# HEALTH_MAX_RSS_MB=1024

# Authentication
# FAKE_AUTH=true bypasses JWT verification; it also requires NODE_ENV to be
# set explicitly to development or test
FAKE_AUTH=true

# Required when FAKE_AUTH is not true:
# AUTH_CLIENT_ID=your-client-id
# AUTH_OIDC_DISCOVERY_URL=https://your-auth-provider.com/.well-known/openid-configuration
# AUTH_ACCEPTED_SCOPES=access-as-user
# Expected `aud` claim, defaults to AUTH_CLIENT_ID (Entra ID: api://<client-id>)
# AUTH_AUDIENCE=api://your-client-id
