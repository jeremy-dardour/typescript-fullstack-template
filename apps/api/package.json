{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "description": "Template API",
  "scripts": {
    "build": "nest build",
    "check-types": "tsc -b --noEmit",
    "command:build-and-run:example": "pnpm build && pnpm command:run:example",
    "command:run:example": "node dist/src/commands/main.js example",
    "coverage:merge": "pnpm tsx scripts/merge-coverage.ts",
    "coverage:report": "mkdir -p coverage/.nyc_output && cp coverage/merged/coverage-final.json coverage/.nyc_output/out.json && nyc report  --temp-dir=coverage/.nyc_output --reporter=html --reporter=text-summary --report-dir=coverage/final",
    "db:migrate:create": "mikro-orm migration:create",
    "db:migrate:down": "mikro-orm migration:down",
    "db:migrate:fresh": "mikro-orm migration:fresh",
    "db:migrate:up": "mikro-orm migration:up",
    "db:schema:update": "mikro-orm schema:update --run",
    "db:seed:local": "mikro-orm seeder:run --class=LocalDatabaseSeeder",
    "db-e2e:migrate:down": "DATABASE_URL=postgres-test://postgres-test:postgres-test@localhost:5433/nestjs mikro-orm migration:down",
    "db-e2e:migrate:fresh": "DATABASE_URL=postgres-test://postgres-test:postgres-test@localhost:5433/nestjs mikro-orm migration:fresh",
    "db-e2e:migrate:up": "DATABASE_URL=postgres-test://postgres-test:postgres-test@localhost:5433/nestjs mikro-orm migration:up",
    "dev": "pnpm start:dev",
    "format": "pnpm run prettier:fix && pnpm run lint:fix",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "NODE_ENV=test vitest run",
    "test:cov": "NODE_ENV=test vitest run --coverage",
    "test:cov:all": "pnpm test:cov && pnpm test:cov:e2e",
    "test:cov:e2e": "NODE_ENV=test vitest run --coverage --config ./vitest.e2e.config.mts",
    "test:cov:merged": "pnpm test:cov:all && pnpm coverage:merge && pnpm coverage:report",
    "test:e2e": "NODE_ENV=test vitest run --config ./vitest.e2e.config.mts",
    "test:ui": "NODE_ENV=test vitest --ui",
    "test:watch": "NODE_ENV=test vitest"
  },
  "dependencies": {
    "@mikro-orm/cli": "^6.6.12",
    "@mikro-orm/core": "^6.6.12",
    "@mikro-orm/migrations": "^6.6.12",
    "@mikro-orm/nestjs": "^6.1.2",
    "@mikro-orm/postgresql": "^6.6.12",
    "@mikro-orm/reflection": "^6.6.12",
    "@mikro-orm/seeder": "^6.6.12",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/swagger": "11.2.1",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@scalar/nestjs-api-reference": "^1.1.6",
    "@workspace/api-contracts": "workspace:*",
    "@workspace/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "jose": "^6.2.2",
    "nest-commander": "^3.20.1",
    "nestjs-cls": "^6.2.0",
    "nestjs-pino": "^4.6.1",
    "openid-client": "^6.8.2",
    "pg": "8.16.3",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@golevelup/ts-vitest": "^0.5.2",
    "@nestjs/cli": "^11.0.18",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.18",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.24",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "24.10.2",
    "@types/pg": "8.15.6",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "^17.4.1",
    "eslint": "^9.39.4",
    "istanbul-lib-coverage": "^3.2.2",
    "nest-commander-testing": "^3.5.1",
    "nyc": "^18.0.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/database/mikro-orm.cli.config.ts"
    ],
    "tsConfigPath": "./tsconfig.mikro-cli.json"
  }
}
