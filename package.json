{
  "name": "typescript-fullstack-template",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "db:start": "docker compose -p \"$(basename \"$PWD\")\" up -d",
    "db:stop": "docker compose -p \"$(basename \"$PWD\")\" down",
    "db:migrate:up": "pnpm --filter api db:migrate:up",
    "fix:all": "pnpm lint:fix && pnpm format && pnpm format:top",
    "dev": "pnpm db:start && turbo run dev",
    "build": "turbo run build",
    "build:docker": "DOCKER_BUILDKIT=1 docker build -f deployment/Dockerfile -t template-app:local .",
    "run:docker": "docker run -p 3000:3000 --env-file apps/api/.env.docker.local template-app:local",
    "dependencies:check": "syncpack lint",
    "dependencies:fix": "syncpack fix",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:top": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:e2e": "turbo run test:e2e",
    "prepare": "node -e \"if (process.env.CI !== 'true' && process.env.HUSKY !== '0') require('child_process').execSync('husky')\"",
    "probe": "pnpm --filter web probe",
    "generate:api-types": "API_PORT=${PORT:-$(sed -n 's/^PORT=//p' apps/api/.env 2>/dev/null)}; openapi-typescript http://localhost:${API_PORT:-3000}/openapi.yaml -o ./packages/api-contracts/src/openapi.d.ts && pnpm format --filter @workspace/api-contracts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "eslint": "^10.13.0",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "jiti": "2.7.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-embed": "^0.8.1",
    "prettier-plugin-sql": "^0.20.0",
    "syncpack": "15.3.3",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}
